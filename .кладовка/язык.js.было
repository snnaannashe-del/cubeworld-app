/* ═══════════════════════════════════════════════════════════════════════
   ВЫБОР ЯЗЫКА — список из двадцати языков и кнопка с кодом.

       shared/язык.js

   ── Зачем отдельный файл ───────────────────────────────────────────
   Список языков стоял дважды: на титулке и на странице тарифа. Двадцать
   строк с флагами, набранные вручную в двух местах, — это обещание
   однажды добавить язык в одном файле и забыть про другой. Теперь
   список один.

   ── Что умеет ──────────────────────────────────────────────────────
       CW.языки                       [[код, флаг, имя], …]
       CW.выборЯзыка.ряд(код)         найти строку списка («ru-RU» → ru)
       CW.выборЯзыка.подключить(о)    кнопка, список и всё их поведение
       CW.выборЯзыка.обновить()       перерисовать список и код в кнопке

   Вызов:
       CW.выборЯзыка.подключить({
         кнопка: 'язык-кнопка',   // id
         список: 'язык-список',
         код:    'язык-код',      // куда писать RU/EN, можно не давать
         после:  function () { … } // что перерисовать после смены языка
       });

   Флага в кнопке нет — только код языка. Сам флаг остался в списке.
   Направление письма (rtl для арабского) ставится здесь же: это
   свойство языка, а не страницы.
   ═══════════════════════════════════════════════════════════════════════ */
(function (окно, документ) {
  'use strict';
  var CW = окно.CW = окно.CW || {};

  CW.языки = [
    ['ru','🇷🇺','Русский'],      ['en','🇬🇧','English'],
    ['en-IN','🇮🇳','English (India)'], ['uk','🇺🇦','Українська'],
    ['de','🇩🇪','Deutsch'],      ['fr','🇫🇷','Français'],
    ['fr-CA','🇨🇦','Français (Canada)'], ['es','🇪🇸','Español'],
    ['es-419','🇲🇽','Español (Latinoamérica)'], ['it','🇮🇹','Italiano'],
    ['pt','🇵🇹','Português'],    ['pl','🇵🇱','Polski'],
    ['tr','🇹🇷','Türkçe'],       ['ar','🇸🇦','العربية'],
    ['ar-AE','🇦🇪','العربية (الخليج)'], ['vi','🇻🇳','Tiếng Việt'],
    ['zh','🇨🇳','中文'],          ['ja','🇯🇵','日本語'],
    ['ko','🇰🇷','한국어'],        ['hi','🇮🇳','हिन्दी']
  ];

  var О = null;   /* чем подключили: id кнопки, списка, кода и «после» */

  function узел(имя) { return имя ? документ.getElementById(имя) : null; }

  function ряд(код) {
    var я = код || CW.язык();
    var i;
    for (i = 0; i < CW.языки.length; i++) if (CW.языки[i][0] === я) return CW.языки[i];
    var корень = String(я).split('-')[0];      /* «ru-RU» → «ru» */
    for (i = 0; i < CW.языки.length; i++) if (CW.языки[i][0] === корень) return CW.языки[i];
    return CW.языки[1];                        /* не нашли — английский */
  }

  function обновить() {
    if (!О) return;
    var текущий = CW.язык();
    var р = ряд(текущий);

    var кнопкаКод = узел(О.код);
    if (кнопкаКод) кнопкаКод.textContent = р[0].toUpperCase();
    документ.documentElement.lang = р[0];
    документ.documentElement.dir = (р[0].indexOf('ar') === 0) ? 'rtl' : 'ltr';

    var где = узел(О.список);
    if (!где) return;
    где.innerHTML = '';
    CW.языки.forEach(function (с) {
      var б = документ.createElement('button');
      if (с[0] === текущий) б.className = 'выбран';
      б.innerHTML = '<span>' + с[1] + '</span><span>' + CW.безопасно(с[2]) + '</span>';
      б.onclick = function () {
        CW.язык(с[0]);
        где.classList.remove('видно');
        обновить();
        if (О.после) О.после();
      };
      где.appendChild(б);
    });
  }

  CW.выборЯзыка = {
    ряд: ряд,
    обновить: обновить,
    подключить: function (о) {
      О = о || {};
      var кнопка = узел(О.кнопка), список = узел(О.список);
      if (кнопка && список) {
        кнопка.onclick = function (е) {
          е.stopPropagation();
          список.classList.toggle('видно');
        };
        /* Нажатие где угодно мимо — список закрывается. */
        документ.addEventListener('click', function () {
          список.classList.remove('видно');
        });
      }
      обновить();
    }
  };

})(window, document);
