#!/bin/bash
# Двойной щелчок по этому файлу поднимает страницы на своём компьютере
# и открывает титулку в браузере. Сервер программы при этом боевой,
# тот же, что у сайта, — отдельно ничего поднимать не нужно.
#
# Закрыть: закрыть окно Терминала или нажать Ctrl+C.
#
# Имена переменных здесь латиницей не случайно: bash на маке (версия 3.2)
# кириллические имена не принимает и спотыкается на первой же строке.

cd "$(dirname "$0")" || exit 1

PORT=8080
while lsof -i ":$PORT" >/dev/null 2>&1; do
  PORT=$((PORT + 1))
done

echo "CubeWorld — страницы на http://localhost:$PORT"
echo "Папка: $(pwd)"
echo "Остановить: Ctrl+C"
echo

( sleep 1; open "http://localhost:$PORT/index.html" ) &

python3 -m http.server "$PORT" --bind 127.0.0.1
